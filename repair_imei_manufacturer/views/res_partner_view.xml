<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_res_partner_form_inherit_manufacturer_imei" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.manufacturer.imei</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_manufacturer']" position="after">
                <field name="imei_required" invisible="not is_manufacturer" />
            </xpath>
        </field>
    </record>
</odoo>
