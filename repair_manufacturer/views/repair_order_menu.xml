<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dedicated Action for Manufacturers -->
    <record id="action_repair_manufacturer_partner" model="ir.actions.act_window">
        <field name="name">Manufacturers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <!-- Filter list to show ONLY manufacturers -->
        <field name="domain">[('is_manufacturer', '=', True)]</field>
        <!-- Pre-check 'is_manufacturer' when creating a new record -->
        <field name="context">{
            'default_is_manufacturer': True,
            'default_is_company': True
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Product Manufacturer
            </p>
        </field>
    </record>

    <!-- Menu Item in Repair Configuration -->
    <menuitem id="menu_repair_manufacturer"
              name="Manufacturers"
              parent="repair.repair_menu_config"
              action="action_repair_manufacturer_partner"
              sequence="10"/>

</odoo>