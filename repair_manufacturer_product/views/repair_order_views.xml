<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_inherit_manufacturer_product" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.manufacturer.product</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair_manufacturer.view_repair_order_form_inherit_manufacturer"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='manufacturer_id']" position="after">
                <field name="allowed_category_ids" invisible="1"/>
                <field name="category_id" 
                       options="{'no_create': True}"
                       domain="[('id', 'in', allowed_category_ids)]"
                       invisible="not manufacturer_id"/>
            </xpath>

            <!-- Dynamic domain filter for product selection -->
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="domain">
                    [
                        ('manufacturer_id', '=', manufacturer_id),
                        ('categ_id', '=', category_id if category_id else False)
                    ]
                </attribute>
            </xpath>

        </field>
    </record>
</odoo>